{
  "name": "pulse-band",
  "version": "1.0.1",
  "description": "Real-time AI Coding Agent Status Island for Windows",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "test": "node scripts/test-hook-install.mjs && node scripts/test-band-key-extract.mjs && node --test scripts/test-diagnostics.mjs",
    "build": "tsc && vite build",
    "dist": "npm run build && electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.codeisland.windows",
    "productName": "Pulse",
    "artifactName": "Pulse-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "scripts/claude-hook.cjs"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "keywords": [
    "codeisland",
    "windows",
    "ai",
    "claude-code",
    "codex"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "clsx": "^2.1.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.40.0",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
